# Vault Distributed Object Storage Configuration
REPLICATION_FACTOR=3
WRITE_QUORUM=2
HEALTH_CHECK_INTERVAL_SECONDS=10
STANDBY_NODE=nodeD
PORT=3000

# NextAuth & Google OAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_any_random_secret_string
GOOGLE_CLIENT_ID=your_google_oauth_client_id_from_cloud_console
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
