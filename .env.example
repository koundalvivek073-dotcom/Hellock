# Vault Distributed Object Storage Configuration
REPLICATION_FACTOR=3
WRITE_QUORUM=2
HEALTH_CHECK_INTERVAL_SECONDS=10
STANDBY_NODE=nodeD
PORT=3000

# NextAuth & Google OAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_any_random_secret_string
# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id_from_cloud_console
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ==============================================================================
# NODE TOPOLOGY (see services/nodeTopology.js)
# ==============================================================================
# By default all 4 storage nodes run on this machine's loopback:
#   nodeA 4001, nodeB 4002, nodeC 4003, nodeD 4004
# Set any of the variables below to spread the cluster across real machines
# or containers. No code changes required.

# Interface the micro-nodes bind to. Use 0.0.0.0 inside Docker so published
# ports are reachable; leave unset (127.0.0.1) for normal local development.
# NODE_BIND_HOST=0.0.0.0

# Option 1 - per-node URLs. Highest priority. Accepts a bare host, host:port,
# or a full URL. Both NODEA_URL and NODE_A_URL spellings work.
#   docker-compose example: NODE_A_URL=http://node-a:4001
# NODE_A_URL=http://10.0.0.11:4001
# NODE_B_URL=http://10.0.0.12:4001
# NODE_C_URL=http://10.0.0.13:4001
# NODE_D_URL=http://10.0.0.14:4001

# Option 2 - per-node host + optional port
# NODE_A_HOST=10.0.0.11
# NODE_A_PORT=4001

# Option 3 - move the whole cluster to one host, keeping ports 4001-4004
# NODE_HOST=10.0.0.11
