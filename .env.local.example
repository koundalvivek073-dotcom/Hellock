# ==============================================================================
# HELLOCK: FIREBASE STORAGE CLUSTER CONFIGURATION TEMPLATE (.env.local.example)
# ==============================================================================
# Copy this file to .env.local and paste your 4 Firebase web project configurations.

# Node A: Primary Storage Node 1
NEXT_PUBLIC_FIREBASE_A_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_A_AUTH_DOMAIN=your-project-node-a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_A_PROJECT_ID=your-project-node-a
NEXT_PUBLIC_FIREBASE_A_STORAGE_BUCKET=your-project-node-a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_A_MESSAGING_SENDER_ID=111111111111
NEXT_PUBLIC_FIREBASE_A_APP_ID=1:111111111111:web:aaaaaaaaaaaaaaaaaaaaaa

# Node B: Primary Storage Node 2
NEXT_PUBLIC_FIREBASE_B_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_B_AUTH_DOMAIN=your-project-node-b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_B_PROJECT_ID=your-project-node-b
NEXT_PUBLIC_FIREBASE_B_STORAGE_BUCKET=your-project-node-b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_B_MESSAGING_SENDER_ID=222222222222
NEXT_PUBLIC_FIREBASE_B_APP_ID=1:222222222222:web:bbbbbbbbbbbbbbbbbbbbbb

# Node C: Primary Storage Node 3
NEXT_PUBLIC_FIREBASE_C_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_C_AUTH_DOMAIN=your-project-node-c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_C_PROJECT_ID=your-project-node-c
NEXT_PUBLIC_FIREBASE_C_STORAGE_BUCKET=your-project-node-c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_C_MESSAGING_SENDER_ID=333333333333
NEXT_PUBLIC_FIREBASE_C_APP_ID=1:333333333333:web:cccccccccccccccccccccc

# Node D: Standby / Failover Node
NEXT_PUBLIC_FIREBASE_D_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_D_AUTH_DOMAIN=your-project-node-d.firebaseapp.com
NEXT_PUBLIC_FIREBASE_D_PROJECT_ID=your-project-node-d
NEXT_PUBLIC_FIREBASE_D_STORAGE_BUCKET=your-project-node-d.firebasestorage.app
NEXT_PUBLIC_FIREBASE_D_MESSAGING_SENDER_ID=444444444444
NEXT_PUBLIC_FIREBASE_D_APP_ID=1:444444444444:web:dddddddddddddddddddddd
