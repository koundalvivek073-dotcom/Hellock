# ==============================================================================
# Node E: USER IDENTITY DATABASE (Phone Auth + Firestore)
# ==============================================================================
# This is a SEPARATE Firebase project used ONLY for user identity (not storage).
# It stores phone number -> user profile mappings in Firestore.
# Firebase Phone Auth is on the FREE Spark plan - no billing needed.
#
# Setup steps:
#  1. console.firebase.google.com -> Create new project (e.g. "hellock-users")
#  2. Authentication -> Sign-in method -> Enable "Phone"
#  3. Firestore Database -> Create database (Start in test mode)
#  4. Project Settings -> General -> "Your apps" -> Add Web App -> copy config below
#  5. Project Settings -> Service accounts -> Generate new private key -> copy fields below
#
# CLIENT-SIDE vars (used by PhoneLoginForm for OTP flow in the browser):
NEXT_PUBLIC_FIREBASE_E_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_E_AUTH_DOMAIN=your-hellock-users.firebaseapp.com
NEXT_PUBLIC_FIREBASE_E_PROJECT_ID=your-hellock-users
NEXT_PUBLIC_FIREBASE_E_STORAGE_BUCKET=your-hellock-users.firebasestorage.app
NEXT_PUBLIC_FIREBASE_E_MESSAGING_SENDER_ID=555555555555
NEXT_PUBLIC_FIREBASE_E_APP_ID=1:555555555555:web:eeeeeeeeeeeeeeeeeeeeee

# SERVER-SIDE admin vars (used by phoneAuthService.js - NOT exposed to the browser):
FIREBASE_E_PROJECT_ID=your-hellock-users
FIREBASE_E_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-hellock-users.iam.gserviceaccount.com
FIREBASE_E_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...your key here...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# OAuth Providers (optional - demo login works without these)
# ==============================================================================

# Google OAuth (free tier, but requires a billing account attached on GCP):
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-secret

# GitHub OAuth (100% FREE - no billing, no credit card required):
# github.com/settings/developers -> OAuth Apps -> New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000
